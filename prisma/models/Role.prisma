model Role {
  id String @id @default(uuid()) @db.Uuid

  // Identificação
  name        String
  description String

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relações
  accounts    Account[]
  permissions RolePermission[]

  @@index([name])
  @@map("roles")
}
