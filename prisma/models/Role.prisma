enum RoleName {
  ADMIN
  USER
  MODERATOR
  TESTER
}

model Role {
  id String @id @default(uuid()) @db.Uuid

  // Identificação
  name        RoleName @default(TESTER)
  description String?

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime? 

  // Relações
  accounts    Account[]
  permissions RolePermission[]

  @@index([name])
  @@map("roles")
}
