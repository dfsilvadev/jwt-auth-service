model Permission {
  id String @id @default(uuid()) @db.Uuid

  // Identificação
  name        String
  code        String  @unique
  description String?

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relações
  roles RolePermission[]

  @@index([code])
  @@map("permissions")
}
