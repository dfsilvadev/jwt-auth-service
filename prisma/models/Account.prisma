enum AccountStatus {
  ACTIVE
  PENDING
  SUSPENDED
  DELETED

  @@map("AccountStatus")
}

model Account {
  id String @id @default(uuid()) @db.Uuid

  // Identificação
  name         String
  email        String        @unique
  passwordHash String
  status       AccountStatus @default(ACTIVE)
  roleId       String        @db.Uuid

  // Timestamps
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  // Relações
  role Role @relation(fields: [roleId], references: [id])

  // Índices compostos para otimizar queries comuns
  @@index([email, deletedAt], name: "idx_accounts_email_deleted")
  @@index([status, deletedAt], name: "idx_accounts_status_deleted")
  @@index([deletedAt], name: "idx_accounts_deleted")
  @@map("accounts")
}
