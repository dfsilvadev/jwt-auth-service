enum AccountStatus {
  ACTIVE
  PENDING
  SUSPENDED
  DELETED
}

model Account {
  id String @id @default(uuid()) @db.Uuid

  // Identifier
  name         String
  email        String @unique
  passwordHash String

  // Status
  status AccountStatus @default(ACTIVE)

  // Timestamps
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@map("accounts")
}
