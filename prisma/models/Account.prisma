enum AccountStatus {
  ACTIVE
  PENDING
  SUSPENDED
  DELETED

  @@map("AccountStatus")
}

model Account {
  id           String        @id @default(uuid()) @db.Uuid
  name         String
  email        String        @unique
  passwordHash String
  status       AccountStatus @default(ACTIVE)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@map("accounts")
}
